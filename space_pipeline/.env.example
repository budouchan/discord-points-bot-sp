# ============ OpenAI ============
# APIキー(必須)
OPENAI_API_KEY=sk-...

# 文字起こしモデル: whisper-1 / gpt-4o-transcribe / gpt-4o-mini-transcribe
# (whisper-1 のみ詳細タイムスタンプ対応。他モデルはチャンク単位のタイムスタンプ)
TRANSCRIBE_MODEL=whisper-1

# コンテンツ生成モデル
GPT_MODEL=gpt-5.5

# ============ 録音 ============
INPUT_DEVICE=BlackHole
SILENCE_STOP_SEC=90
SILENCE_THRESHOLD=0.01

# ============ 番組(ブドキン)設定 ============
SHOW_NAME=ブドキン
# MC名(空欄なら文字起こしから推定)
MC_NAME=
# 曜日パーソナリティ(空欄なら文字起こしから推定)
WEEKDAY_PERSONALITIES=月:名前,火:名前,水:名前,木:名前,金:名前
# X投稿の「録音はこちら」に入れるURL
RECORDING_URL=
# 毎回必ず付けるハッシュタグ
DEFAULT_HASHTAGS=#ブドキン

# ============ WordPress ============
WP_DEFAULT_CATEGORY=ブドキン

# ============ 切り抜き動画 ============
CLIP_ENABLED=true
CLIP_MAX_COUNT=5
CLIP_RESOLUTION=1280x720

# ============ Obsidian ============
# Vaultのパスを指定すると「YYYY-MM-DD ブドキン.md」として自動保存
# 例: /Users/あなた/Documents/Obsidian/MyVault
OBSIDIAN_VAULT_DIR=

# ============ Discord ============
# Webhook URLを設定すると「今日のまとめ」を自動投稿(空なら生成のみ)
DISCORD_WEBHOOK_URL=

# ============ 出力 ============
OUTPUT_DIR=recordings
